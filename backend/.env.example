# Backend environment variables (copy to backend/.env and fill in)

# --- Current (3-tier proxy, pre-redesign) ---
# Points Django at the FastAPI model server. Only used until the
# collapse-to-one-backend redesign lands (see HANDOFF.md, Phase 2).
MODEL_SERVER_URL="http://localhost:8081/api/v1/openai"

# --- Planned (collapsed Django + OpenAI direct, Phase 2) ---
# Real AI runs through these once services.py is rewritten to call OpenAI directly.
OPENAI_API_KEY=""

# Production hardening (Railway)
# DEBUG=False
# ALLOWED_HOSTS="<your-railway-domain>,localhost,127.0.0.1"
# FRONTEND_ORIGIN="https://<your-app>.vercel.app"
